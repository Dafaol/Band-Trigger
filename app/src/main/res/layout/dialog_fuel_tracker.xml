<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#181818"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:strokeColor="#2C2C2C"
    app:strokeWidth="1dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Cabeçalho -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⛽ Fuel Tracker"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchFuelModuleActive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@color/bottom_nav_colors" />
            </LinearLayout>

            <!-- Atalhos: Trip History & Stats -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTripHistory"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="🗓️ Trip History"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="#3A3A3A" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFuelStats"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="📊 Statistics"
                    android:textAllCaps="false"
                    android:textColor="#BB86FC"
                    android:textSize="12sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="#BB86FC" />
            </LinearLayout>

            <!-- Card de Status -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#222222"
                app:cardCornerRadius="14dp"
                app:strokeColor="#303030"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvFuelStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="14.00 L"
                        android:textColor="#BB86FC"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFuelRange"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Range: ~476 km | Trip: 0.0 km | Odo: 0.0 km"
                        android:textColor="#BBBBBB"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvOilStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="🛢️ Oil: Not configured"
                        android:textColor="#9E9E9E"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Botão Principal GPS -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleTrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingVertical="10dp"
                android:text="Start Trip (GPS)"
                android:textAllCaps="false"
                android:textColor="#121212"
                android:textStyle="bold"
                app:backgroundTint="#BB86FC"
                app:cornerRadius="12dp" />

            <!-- Ações Rápidas (Full Tank / Reserve / Reset Oil) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFullTank"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="Full Tank"
                    android:textAllCaps="false"
                    android:textColor="#BB86FC"
                    android:textSize="12sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="#BB86FC" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHitReserve"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:text="Hit Reserve"
                    android:textAllCaps="false"
                    android:textColor="#FF5252"
                    android:textSize="12sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="#FF5252" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetOil"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="Reset Oil"
                    android:textAllCaps="false"
                    android:textColor="#FFB74D"
                    android:textSize="12sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="#FFB74D" />
            </LinearLayout>

            <!-- Botão Undo (Manual e GPS) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUndoFuel"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="↺ Undo"
                android:textAllCaps="false"
                android:textColor="#FFB74D"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Seção: Odômetro e Tanque -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="ODOMETER &amp; TANK"
                android:textColor="#888888"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Current Odometer (km)"
                android:textColor="#CCCCCC"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/editOdometer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#BB86FC"
                android:hint="e.g. 15800.0"
                android:inputType="numberDecimal"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tank (L)"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/editTankCapacity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#BB86FC"
                        android:inputType="numberDecimal"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reserve (L)"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/editReserveLiters"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#BB86FC"
                        android:inputType="numberDecimal"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Avg (km/L)"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/editFuelAverage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#BB86FC"
                        android:inputType="numberDecimal"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Seção: Troca de Óleo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="OIL CHANGE REMINDER"
                android:textColor="#888888"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Last Oil Odo (km)"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/editOilLastOdo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#FFB74D"
                        android:hint="e.g. 15000.0"
                        android:inputType="numberDecimal"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#666666"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Interval (km)"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/editOilInterval"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#FFB74D"
                        android:hint="1000"
                        android:inputType="numberDecimal"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#666666"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Seção: Filtros Inteligentes de GPS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="GPS SMART FILTERS (ANTI-ACCIDENTAL)"
                android:textColor="#888888"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Min Distance (km)"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/editMinTripKm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#BB86FC"
                        android:hint="1.0"
                        android:inputType="numberDecimal"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#666666"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Min Peak (km/h)"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/editMinPeakSpeed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#BB86FC"
                        android:hint="15"
                        android:inputType="numberDecimal"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#666666"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Rodapé -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCloseFuel"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Close"
                    android:textAllCaps="false"
                    android:textColor="#AAAAAA" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveFuel"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Save Config"
                    android:textAllCaps="false"
                    android:textColor="#BB86FC"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</com.google.android.material.card.MaterialCardView>
<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#2C2C2C"
    app:cardCornerRadius="24dp"
    app:cardElevation="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabeçalho (Fundo mais escuro) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#151515"
            android:padding="20dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select Action"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Opção 1: Add Automation -->
        <TextView
            android:id="@+id/optionAddAutomation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="20dp"
            android:text="Add Automation"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <!-- Linha Separadora Sutil -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#444444" />

        <!-- Opção 2: Create Folder -->
        <TextView
            android:id="@+id/optionCreateFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="20dp"
            android:text="Create Folder"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Line 1: Version -->
        <TextView
            android:id="@+id/textVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Version --"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Creator Badge (Elegant Background Container) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:cardBackgroundColor="#1A1A1A"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#33BB86FC"
            app:strokeWidth="1dp">

            <!-- Inside the Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="32dp"
                android:paddingTop="16dp"
                android:paddingEnd="32dp"
                android:paddingBottom="16dp">

                <!-- Line 2: Small "Made by" text -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Developed by"
                    android:textColor="#888888"
                    android:textSize="14sp" />

                <!-- Line 3: Highlighted Creator Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Dafaol Creations"
                    android:textColor="#BB86FC"
                    android:textSize="24sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- App Description -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Band Trigger allows you to command your smart home right from your wrist using media controls."
            android:textAlignment="center"
            android:textColor="#CCCCCC"
            android:textSize="16sp" />

        <!-- GitHub Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGithub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:padding="12dp"
            android:text="GitHub Repository"
            android:textColor="#FFFFFF"
            app:backgroundTint="#24292E" />

        <!-- ArtStation Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnArtstation"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:text="ArtStation"
            android:textColor="#FFFFFF"
            app:strokeColor="#888888" />

        <!-- Donate Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDonate"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Buy me a coffee ☕"
            android:textColor="#BB86FC" />

    </LinearLayout>
</ScrollView>
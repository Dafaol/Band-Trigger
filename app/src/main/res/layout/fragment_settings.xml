<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Switch for Hijack Band Focus -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchHijackFocus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hijack Band Focus"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        app:thumbTint="@color/bottom_nav_colors" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Automatically takes over the smartwatch screen when other media is paused. If disabled, the app still works. However, you need to open the app whenever you pause media on your phone so that Band Trigger gains control of the watch's media playback."
        android:textColor="#AAAAAA"
        android:textSize="14sp" />

    <!-- Line/Separator -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:background="#2A2A2A" />

    <!-- Extra Modules -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Extra Modules (Smartband)"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Hidden Camera Switch -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchHiddenCamera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Hidden Camera"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:thumbTint="#BB86FC"
        app:trackTint="#88BB86FC" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Allows creating automations to silently take pictures and save them to the gallery."
        android:textColor="#888888"
        android:textSize="14sp" />

    <!-- Audio Recorder Switch -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchAudioRecorder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Audio Recorder"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:thumbTint="#BB86FC"
        app:trackTint="#88BB86FC" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Allows creating automations to record audio via microphone (Play starts, Pause stops)."
        android:textColor="#888888"
        android:textSize="14sp" />

    <!-- Line/Separator -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="32dp"
        android:background="#2A2A2A" />

    <!-- Exit Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnExitApp"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:padding="12dp"
        android:text="Turn Off and Exit"
        android:textColor="#FF5252"
        app:strokeColor="#FF5252" />
</LinearLayout>
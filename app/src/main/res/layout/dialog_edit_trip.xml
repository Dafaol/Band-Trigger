<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#181818"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:strokeColor="#2E2E2E"
    app:strokeWidth="1dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✏️ Edit Trip"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEditTripHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Nov 20 • +10.00 km"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Tag (Category)"
                android:textColor="#CCCCCC"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/editTripTag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#BB86FC"
                android:hint="e.g. Work, Leisure, Errands"
                android:inputType="textCapWords"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:textSize="14sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutQuickTagChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Note (Optional)"
                android:textColor="#CCCCCC"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/editTripNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#BB86FC"
                android:hint="e.g. Heavy traffic, detour..."
                android:inputType="textCapSentences"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreateRuleFromTrip"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="⚡ Create Auto-Tag Rule from this trip"
                android:textAllCaps="false"
                android:textColor="#FFB74D"
                android:textSize="12sp"
                app:cornerRadius="12dp"
                app:strokeColor="#FFB74D" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteTrip"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delete"
                    android:textAllCaps="false"
                    android:textColor="#FF5252" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelEditTrip"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cancel"
                    android:textAllCaps="false"
                    android:textColor="#AAAAAA" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveEditTrip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Save"
                    android:textAllCaps="false"
                    android:textColor="#121212"
                    android:textStyle="bold"
                    app:backgroundTint="#BB86FC"
                    app:cornerRadius="10dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</com.google.android.material.card.MaterialCardView>